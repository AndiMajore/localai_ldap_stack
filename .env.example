# Production configuration. Copy to .env and fill in.
# Generate the secrets with: scripts/gen-secrets.sh  (prints lines to paste below)
# For local development use dev/.env.example instead (see dev/README.md).

# Public hostnames: ai.${DOMAIN} (API + key UI) and auth.${DOMAIN} (SSO).
# Both must resolve to this server; TLS certificate for both goes to certs/stack.crt + certs/stack.key.
DOMAIN=example.org

# ---- Images (pin to digests for production) ----
TRAEFIK_TAG=v3.7.14
AUTHENTIK_TAG=2026.8.3
# Decision models need a current master build. Use master-gpu-nvidia-cuda-13 on Blackwell
# (needed for vllm-cpp models such as Tev1), or master for CPU-only hosts.
LOCALAI_TAG=master-gpu-nvidia-cuda-12
# Backends installed on boot; prefix must match the image flavour
# (cuda12-*, cuda13-*, or cpu-* for CPU images).
# llama-cpp must be the *-development* (master) build: the release build predates
# native decision-model support and fails to load the decision GGUFs.
LOCALAI_BACKENDS=cuda12-transformers,cuda12-rerankers,cuda12-llama-cpp-development

# ---- Postgres (shared by Authentik and LocalAI) ----
PG_USER=authentik
PG_DB=authentik
PG_PASS=
LOCALAI_DB_PASS=

# ---- Authentik ----
AUTHENTIK_SECRET_KEY=
# Password for the built-in "akadmin" user (Authentik admin UI at https://auth.${DOMAIN}/if/admin/).
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.org

# ---- LDAP / Active Directory (users and groups are synced into Authentik) ----
# ldap://host:389, or ldaps://host:636. With ldap:// you can enable StartTLS.
LDAP_URL=ldaps://ldap.example.org:636
LDAP_START_TLS=false
# Read-only service account used for binding and syncing.
LDAP_BIND_DN=cn=svc-embedder,ou=services,dc=example,dc=org
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=dc=example,dc=org
# Where users and groups live, relative to LDAP_BASE_DN (empty = whole base DN).
LDAP_USER_DN=ou=people
LDAP_GROUP_DN=ou=groups
# Only members of this group may log in and create API keys.
API_USERS_GROUP=ai-api-users
# OpenLDAP-style defaults. For Active Directory use instead:
#   LDAP_USER_FILTER=(&(objectClass=user)(!(objectClass=computer)))
#   LDAP_GROUP_FILTER=(objectClass=group)
#   LDAP_UNIQUENESS_FIELD=objectSid
#   LDAP_USERNAME_ATTRIBUTE=sAMAccountName
#   LDAP_NAME_ATTRIBUTE=displayName
LDAP_USER_FILTER=(objectClass=inetOrgPerson)
LDAP_GROUP_FILTER=(objectClass=groupOfNames)
LDAP_GROUP_MEMBERSHIP_FIELD=member
LDAP_UNIQUENESS_FIELD=entryUUID
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_NAME_ATTRIBUTE=cn
LDAP_MAIL_ATTRIBUTE=mail

# ---- LocalAI ----
LOCALAI_OIDC_CLIENT_SECRET=
# This user becomes a LocalAI admin on login (must exist in LDAP with this mail).
LOCALAI_ADMIN_EMAIL=admin@example.org
# Default lifetime of user-created API keys (empty = never expire).
LOCALAI_DEFAULT_API_KEY_EXPIRY=180d
# Ollama-like lifecycle: load on first request, unload after idle timeout, LRU cap.
LOCALAI_WATCHDOG_IDLE_TIMEOUT=20m
LOCALAI_MAX_ACTIVE_BACKENDS=4

# ---- Traefik rate limit for the inference API (per API key) ----
API_RATE_AVERAGE=20
API_RATE_BURST=60
