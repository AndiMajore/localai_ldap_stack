# Local development configuration. From the repository root:
#   cp dev/.env.example .env && dev/scripts/gen-secrets.sh   # then paste the printed secrets below
# Start with: docker compose -f docker-compose.yml -f dev/compose.dev.yml up -d

# localtest.me resolves to 127.0.0.1: http://ai.localtest.me and http://auth.localtest.me
DOMAIN=localtest.me

# ---- Images ----
TRAEFIK_TAG=v3.7.14
AUTHENTIK_TAG=2026.8.3
LOCALAI_TAG=master-gpu-nvidia-cuda-12
# cpu-vllm-cpp-development: runs vllm-cpp decision models (e.g. Tev1) on the CPU, since the
# CUDA build of vllm-cpp needs a Blackwell GPU.
LOCALAI_BACKENDS=cuda12-transformers,cuda12-rerankers,cuda12-llama-cpp-development,cpu-vllm-cpp-development

# ---- Postgres ----
PG_USER=authentik
PG_DB=authentik
PG_PASS=
LOCALAI_DB_PASS=

# ---- Authentik ----
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.org

# ---- Test LDAP directory (container "openldap" from dev/compose.dev.yml) ----
LDAP_URL=ldap://openldap:389
LDAP_START_TLS=false
LDAP_ORGANISATION=Example Org
LDAP_DOMAIN=example.org
LDAP_BASE_DN=dc=example,dc=org
LDAP_BIND_DN=cn=admin,dc=example,dc=org
# Admin password of the test directory (also used by the stack to bind).
LDAP_BIND_PASSWORD=
# Password of the seeded test users alice, bob, carol.
LDAP_SEED_USER_PASSWORD=
LDAP_USER_DN=ou=people
LDAP_GROUP_DN=ou=groups
API_USERS_GROUP=ai-api-users

# ---- LocalAI ----
LOCALAI_OIDC_CLIENT_SECRET=
# carol is the test admin.
LOCALAI_ADMIN_EMAIL=carol@example.org
LOCALAI_DEFAULT_API_KEY_EXPIRY=180d

# ---- Traefik rate limit ----
API_RATE_AVERAGE=20
API_RATE_BURST=60
